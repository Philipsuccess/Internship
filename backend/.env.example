# =============================================================================
# Backend Environment Configuration
# =============================================================================

# 1. Google Gemini API Credentials (REQUIRED)
# Obtain your API key from Google AI Studio: https://aistudio.google.com/
# NEVER commit your actual API key to version control or share publicly!
GEMINI_API_KEY=your_gemini_api_key_here

# 2. Deployment Environment & Logging
# Options: development | staging | production
ENVIRONMENT=development
# Options: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# 3. Model Configuration
# Primary model (recommended: gemini-3.5-flash-lite for cost and speed)
MODEL_NAME=gemini-3.5-flash-lite
# Comma-separated list of fallback models tried on transient 503 high-demand errors
FALLBACK_MODELS=gemini-3.1-flash-lite,gemini-3-flash-preview,gemini-3.8-flash

# 4. Context Window & Persona Safeguards
# Maximum historical turns submitted to Gemini context window (sliding window)
MAX_HISTORY_MESSAGES=20
# Default persona: default | student_tutor | coding_assistant | customer_support | movie_recommender | business_assistant
CHATBOT_PERSONA=default
# Optional custom system instruction string overriding predefined personas
# CUSTOM_SYSTEM_INSTRUCTION="You are a custom AI assistant..."

# 5. Network & Server Configuration
# In production containers / VMs, bind to 0.0.0.0; in local dev, use 127.0.0.1
HOST=127.0.0.1
PORT=8000

# 6. CORS & Security
# Comma-separated list of allowed frontend origins (NO trailing slashes)
# In production, set to your live frontend domain: e.g., https://mychatbot.com
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Automatically disables /docs and /redoc in production unless explicitly enabled
ENABLE_DOCS=true
# Enable standard security headers (X-Frame-Options, X-Content-Type-Options, etc.)
SECURITY_HEADERS=true

# =============================================================================
# Frontend Environment Configuration
# =============================================================================

# Backend API Base URL
#
# LOCAL DEVELOPMENT:
# Leave blank (or empty string) because Vite dev server proxies /api and /health
# directly to http://127.0.0.1:8000 via vite.config.js.
#
# PRODUCTION DEPLOYMENT:
# - If frontend and backend are served on the same domain (e.g. reverse proxy / Nginx):
#   Leave blank (or empty string) to use relative paths (/api/chat, /health).
# - If frontend is hosted on a separate domain (e.g. Vercel, Netlify, S3/CloudFront)
#   and backend is on another (e.g. https://api.mychatbot.com):
#   Set to the full backend URL without trailing slash:
#   VITE_API_BASE_URL=https://api.mychatbot.com
#
# IMPORTANT SECURITY NOTICE:
# NEVER place Gemini API keys or private backend credentials in frontend environment files!
VITE_API_BASE_URL=
